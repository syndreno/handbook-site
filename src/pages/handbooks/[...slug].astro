---
import type { GetStaticPaths } from "astro";
import DocsLayout from "@/layouts/DocsLayout.astro";
import LegacyRedirect from "@/components/LegacyRedirect.astro";
import { getCategories, getDocumentNeighbors, getDocuments, getRelatedDocuments } from "@/utils/documents";
import { renderMarkdown } from "@/utils/markdown";
import { slugify, withBase } from "@/utils/path";

export const getStaticPaths = (async () => {
  const documents = await getDocuments();
  const canonicalSlugs = new Set(documents.map((document) => document.slug));
  const aliases = new Map<string, string | undefined>();

  for (const document of documents) {
    const pathParts = document.sourcePath.split("/");
    if (pathParts.length < 3) continue;
    const alias = [
      slugify(pathParts[0]),
      slugify(pathParts.at(-1)!.replace(/\.md$/i, ""))
    ].join("/");
    aliases.set(alias, aliases.has(alias) ? undefined : document.sourcePath);
  }

  const canonicalPaths = documents.map((document) => ({
    params: { slug: document.slug },
    props: { sourcePath: document.sourcePath, redirectTo: undefined as string | undefined }
  }));
  const aliasPaths = [...aliases.entries()]
    .filter((entry): entry is [string, string] => Boolean(entry[1]) && !canonicalSlugs.has(entry[0]))
    .map(([slug, sourcePath]) => ({
      params: { slug },
      props: {
        sourcePath,
        redirectTo: withBase(documents.find((item) => item.sourcePath === sourcePath)!.route)
      }
    }));

  return [...canonicalPaths, ...aliasPaths];
}) satisfies GetStaticPaths;

const { sourcePath, redirectTo } = Astro.props;
const documents = await getDocuments();
const document = documents.find((item) => item.sourcePath === sourcePath);
if (!document) throw new Error(`Handbook not found: ${sourcePath}`);
const html = redirectTo ? "" : await renderMarkdown(document);
const categories = redirectTo ? [] : await getCategories(documents);
const { previous, next } = redirectTo
  ? { previous: undefined, next: undefined }
  : await getDocumentNeighbors(document, documents);
const related = redirectTo ? [] : await getRelatedDocuments(document, 3, documents);
---

{redirectTo
  ? <LegacyRedirect to={redirectTo} />
  : <DocsLayout {document} {categories} {html} {previous} {next} {related} />}

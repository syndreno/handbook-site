---
import type { GetStaticPaths } from "astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import HandbookCard from "@/components/HandbookCard.astro";
import { getCategories } from "@/utils/documents";

export const getStaticPaths = (() => getCategories().map((category) => ({ params: { category: category.slug }, props: { category } }))) satisfies GetStaticPaths;
const { category } = Astro.props;
---

<BaseLayout title={category.name} description={`Explore ${category.documents.length} ${category.name} handbooks.`}>
  <main class="listing-page" id="main-content">
    <header class="listing-header"><span class="eyebrow">Category</span><h1>{category.name}</h1><p>{category.documents.length} handbook{category.documents.length === 1 ? "" : "s"} · {category.wordCount.toLocaleString()} words of learning material</p></header>
    <div class="handbook-grid">{category.documents.map((document) => <HandbookCard document={document} />)}</div>
  </main>
</BaseLayout>

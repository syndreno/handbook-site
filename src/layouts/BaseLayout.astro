---
import { siteConfig } from "@/config/site";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import "@/styles/global.css";

interface Props {
  title?: string;
  headline?: string;
  description?: string;
  type?: "website" | "article";
  robots?: string;
  keywords?: string[];
  articleSection?: string;
  wordCount?: number;
  breadcrumbs?: Array<{ name: string; path: string }>;
}
const {
  title = siteConfig.title,
  headline = title,
  description = siteConfig.description,
  type = "website",
  robots = "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1",
  keywords = [],
  articleSection,
  wordCount,
  breadcrumbs = []
} = Astro.props;
const brandedTitle = title === siteConfig.title ? title : `${title} | ${siteConfig.shortTitle}`;
const pageTitle = brandedTitle.length <= 65 ? brandedTitle : title;
const siteRoot = new URL(import.meta.env.BASE_URL, Astro.site ?? Astro.url);
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
const socialImage = new URL(`${import.meta.env.BASE_URL}social-card.png`, Astro.site ?? Astro.url);
const organizationId = new URL("#organization", siteRoot).href;
const websiteId = new URL("#website", siteRoot).href;
const webpageId = new URL("#webpage", canonical).href;
const breadcrumbItems = breadcrumbs.map((item, index) => ({
  "@type": "ListItem",
  position: index + 1,
  name: item.name,
  item: new URL(item.path.replace(/^\//, ""), siteRoot).href
}));
const pageSchema = {
  "@type": type === "article" ? "TechArticle" : "WebPage",
  "@id": webpageId,
  url: canonical.href,
  name: pageTitle,
  ...(type === "article" ? { headline } : {}),
  description,
  inLanguage: "en",
  isPartOf: { "@id": websiteId },
  ...(type === "article" ? {
    author: { "@id": organizationId },
    publisher: { "@id": organizationId },
    mainEntityOfPage: { "@id": webpageId },
    license: siteConfig.community.contentLicense.url,
    ...(articleSection ? { articleSection } : {}),
    ...(wordCount ? { wordCount } : {}),
    ...(keywords.length ? { keywords: keywords.join(", ") } : {})
  } : {}),
  ...(breadcrumbItems.length ? { breadcrumb: { "@id": `${canonical.href}#breadcrumb` } } : {})
};
const structuredData = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": organizationId,
      name: siteConfig.title,
      url: siteRoot.href,
      logo: {
        "@type": "ImageObject",
        url: new URL(`${import.meta.env.BASE_URL}favicon.svg`, Astro.site ?? Astro.url).href
      }
    },
    {
      "@type": "WebSite",
      "@id": websiteId,
      url: siteRoot.href,
      name: siteConfig.title,
      description: siteConfig.description,
      publisher: { "@id": organizationId },
      inLanguage: "en"
    },
    pageSchema,
    ...(breadcrumbItems.length ? [{
      "@type": "BreadcrumbList",
      "@id": `${canonical.href}#breadcrumb`,
      itemListElement: breadcrumbItems
    }] : [])
  ]
}).replace(/</g, "\\u003c");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content="#f7f8fa" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#111315" media="(prefers-color-scheme: dark)" />
    <link rel="canonical" href={canonical} />
    <link rel="license" href={siteConfig.community.contentLicense.url} />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} data-dynamic-favicon />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={siteConfig.title} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${siteConfig.title} - ${siteConfig.tagline}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={`${siteConfig.title} - ${siteConfig.tagline}`} />
    <title>{pageTitle}</title>
    <script is:inline type="application/ld+json" set:html={structuredData}></script>
    <script is:inline>
      (() => {
        const choice = localStorage.getItem("handbook-theme") || "system";
        const dark = choice === "dark" || (choice === "system" && matchMedia("(prefers-color-scheme: dark)").matches);
        const root = document.documentElement;
        const favicon = document.querySelector("[data-dynamic-favicon]");
        const contrast = (hex) => {
          const values = [1, 3, 5].map((index) => parseInt(hex.slice(index, index + 2), 16));
          const luminance = (values[0] * 299 + values[1] * 587 + values[2] * 114) / 255000;
          return luminance > .58 ? "#111315" : "#ffffff";
        };
        const updateFavicon = (color) => {
          if (!(favicon instanceof HTMLLinkElement) || !/^#[0-9a-f]{6}$/i.test(color)) return;
          const foreground = contrast(color);
          const svg = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64"><rect width="64" height="64" rx="12" fill="${color}"/><g transform="translate(8 8) scale(2)" fill="none" stroke="${foreground}" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v16"/><path d="M16 13h2"/><path d="M16 9h2"/><path d="M20.001 19A2 2 0 0 0 22 17V5a2 2 0 0 0-1.999-2L16 3.002A5 5 0 0 0 12 5a5 5 0 0 0-4-2H4a2 2 0 0 0-2 2v12a2 2 0 0 0 1.999 2H8a5 5 0 0 1 4 2 5 5 0 0 1 4-2z"/><path d="M6 13h2"/><path d="M6 9h2"/></g></svg>`;
          favicon.href = `data:image/svg+xml,${encodeURIComponent(svg)}`;
        };
        window.addEventListener("handbook:icon-color", (event) => {
          const color = event instanceof CustomEvent ? event.detail : "";
          if (typeof color === "string") updateFavicon(color);
        });
        root.dataset.theme = dark ? "dark" : "light";
        root.dataset.themeChoice = choice;
        try {
          const settings = JSON.parse(localStorage.getItem("handbook-appearance") || "{}");
          const isHex = (value) => typeof value === "string" && /^#[0-9a-f]{6}$/i.test(value);
          const fonts = {
            system: 'Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif',
            readable: 'Verdana, Tahoma, "Segoe UI", sans-serif',
            serif: 'Georgia, Cambria, "Times New Roman", serif',
            mono: '"Cascadia Code", "SFMono-Regular", Consolas, monospace'
          };
          if (isHex(settings.accent)) {
            root.style.setProperty("--accent", settings.accent);
            root.style.setProperty("--accent-contrast", contrast(settings.accent));
            root.dataset.customAccent = "";
          }
          const iconColor = isHex(settings.icon)
            ? settings.icon
            : isHex(settings.accent)
              ? settings.accent
              : dark ? "#5bc29f" : "#176b55";
          if (isHex(settings.icon)) {
            root.style.setProperty("--brand-icon-color", iconColor);
            root.style.setProperty("--brand-icon-contrast", contrast(iconColor));
          }
          updateFavicon(iconColor);
          if (isHex(settings.background)) {
            root.style.setProperty("--bg", settings.background);
            root.dataset.customBackground = "";
          }
          if (isHex(settings.text)) {
            root.style.setProperty("--text", settings.text);
            root.dataset.customText = "";
          }
          if (isHex(settings.progress)) root.style.setProperty("--reading-progress-color", settings.progress);
          if (settings.font in fonts) root.style.setProperty("--appearance-font-family", fonts[settings.font]);
          if (Number.isFinite(settings.fontSize)) root.style.setProperty("--reading-font-size", `${Math.min(22, Math.max(14, settings.fontSize))}px`);
          if (Number.isFinite(settings.lineHeight)) root.style.setProperty("--reading-line-height", String(Math.min(2, Math.max(1.5, settings.lineHeight))));
          if (Number.isFinite(settings.tocFontSize)) root.style.setProperty("--toc-font-size", `${Math.min(18, Math.max(11, settings.tocFontSize))}px`);
          if (settings.showSidebar === false) root.dataset.hideSidebar = "";
          if (settings.showToc === false) root.dataset.hideToc = "";
        } catch { /* Use the theme defaults when saved preferences are unavailable. */ }
      })();
    </script>
  </head>
  <body>
    <Header />
    <slot />
    <Footer />
    <script>
      const anchorOffset = () => {
        const header = document.querySelector<HTMLElement>(".site-header");
        return (header?.getBoundingClientRect().height ?? 0) + 22;
      };

      const anchorTarget = (hash: string) => {
        if (!hash || hash === "#") return null;
        try {
          return document.getElementById(decodeURIComponent(hash.slice(1)));
        } catch {
          return null;
        }
      };

      const alignAnchor = (hash: string, smooth: boolean) => {
        const target = anchorTarget(hash);
        if (!target) return false;
        const top = target.getBoundingClientRect().top + window.scrollY - anchorOffset();
        const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        if (smooth && !reduceMotion) {
          window.scrollTo({ top: Math.max(0, top), behavior: "smooth" });
        } else {
          const root = document.documentElement;
          const previousBehavior = root.style.scrollBehavior;
          root.style.scrollBehavior = "auto";
          window.scrollTo(0, Math.max(0, top));
          root.style.scrollBehavior = previousBehavior;
        }
        return true;
      };

      let cleanupHandbook = () => {};
      let tocObserver: IntersectionObserver | undefined;

      const initializeHandbook = () => {
        cleanupHandbook();
        const progress = document.querySelector<HTMLElement>("[data-reading-progress]");
        const backToTop = document.querySelector<HTMLElement>("[data-back-to-top]");
        if (!progress || !backToTop) return;
        const updateScroll = () => {
          const scrollable = document.documentElement.scrollHeight - innerHeight;
          progress.style.transform = `scaleX(${scrollable > 0 ? Math.min(1, scrollY / scrollable) : 0})`;
          backToTop.classList.toggle("visible", scrollY > 700);
        };
        addEventListener("scroll", updateScroll, { passive: true });
        updateScroll();
        if (!backToTop.dataset.enhanced) {
          backToTop.dataset.enhanced = "true";
          backToTop.addEventListener("click", () => scrollTo({ top: 0, behavior: "smooth" }));
        }
        const copyPage = document.querySelector<HTMLElement>("[data-copy-page]");
        if (copyPage && !copyPage.dataset.enhanced) {
          copyPage.dataset.enhanced = "true";
          copyPage.addEventListener("click", async (event) => {
            await navigator.clipboard.writeText(location.href);
            const button = event.currentTarget as HTMLElement;
            const original = button.innerHTML;
            button.textContent = "Copied";
            setTimeout(() => { button.innerHTML = original; }, 1500);
          });
        }
        document.querySelectorAll<HTMLElement>(".markdown-body pre").forEach((pre) => {
          if (pre.previousElementSibling?.classList.contains("code-toolbar")) return;
          const code = pre.querySelector("code");
          if (!code) return;
          const match = [...code.classList].find((name) => name.startsWith("language-"));
          const language = pre.dataset.language || code.dataset.language || match?.replace("language-", "") || "text";
          const toolbar = document.createElement("div");
          toolbar.className = "code-toolbar";
          toolbar.innerHTML = `<span>${language}</span><button type="button" aria-label="Copy ${language} code">Copy</button>`;
          toolbar.querySelector("button")?.addEventListener("click", async (event) => {
            await navigator.clipboard.writeText(code.textContent || "");
            const button = event.currentTarget as HTMLButtonElement;
            button.textContent = "Copied!";
            setTimeout(() => { button.textContent = "Copy"; }, 1400);
          });
          pre.parentElement?.insertBefore(toolbar, pre);
        });
        cleanupHandbook = () => removeEventListener("scroll", updateScroll);
        window.dispatchEvent(new Event("handbook:layout-ready"));
      };

      const initializeToc = () => {
        tocObserver?.disconnect();
        const tocLinks = [...document.querySelectorAll<HTMLAnchorElement>(".page-toc a")];
        const targets = tocLinks.map((link) => document.getElementById(decodeURIComponent(link.hash.slice(1)))).filter(Boolean) as HTMLElement[];
        if (!targets.length) {
          delete document.documentElement.dataset.hasToc;
          document.body.classList.remove("toc-open");
          document.querySelector("[data-toc-toggle]")?.setAttribute("aria-expanded", "false");
          return;
        }
        document.documentElement.dataset.hasToc = "";
        tocObserver = new IntersectionObserver((entries) => {
          const visible = entries.filter((entry) => entry.isIntersecting).at(-1);
          if (!visible) return;
          tocLinks.forEach((link) => link.classList.toggle("active", link.hash === `#${visible.target.id}`));
        }, { rootMargin: "-15% 0px -75%" });
        targets.forEach((target) => tocObserver?.observe(target));
      };

      const initializeLibrary = () => {
        const grid = document.querySelector<HTMLElement>("[data-library-grid]");
        const search = document.querySelector<HTMLInputElement>("[data-library-search]");
        const category = document.querySelector<HTMLSelectElement>("[data-library-category]");
        const sort = document.querySelector<HTMLSelectElement>("[data-library-sort]");
        const count = document.querySelector<HTMLElement>("[data-result-count]");
        const empty = document.querySelector<HTMLElement>("[data-library-empty]");
        if (!grid || grid.dataset.enhanced) return;
        grid.dataset.enhanced = "true";
        const filter = () => {
          if (!search || !category || !sort) return;
          const cards = [...grid.querySelectorAll<HTMLElement>(".handbook-card")];
          const query = search.value.trim().toLowerCase();
          cards.sort((a, b) => (sort.value === "za" ? -1 : 1) * (a.dataset.title || "").localeCompare(b.dataset.title || ""));
          cards.forEach((card) => grid.append(card));
          let visible = 0;
          cards.forEach((card) => {
            const show = (!query || card.textContent?.toLowerCase().includes(query)) && (category.value === "all" || card.dataset.category === category.value);
            card.hidden = !show;
            if (show) visible++;
          });
          if (count) count.textContent = `${visible} handbook${visible === 1 ? "" : "s"}`;
          if (empty) empty.hidden = visible !== 0;
        };
        [search, category, sort].forEach((control) => control?.addEventListener("input", filter));
      };

      const initializePage = () => {
        initializeHandbook();
        initializeToc();
        initializeLibrary();
      };

      document.addEventListener("click", (event) => {
        if (event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
        if (!(event.target instanceof Element)) return;
        const link = event.target.closest<HTMLAnchorElement>("a[href*='#']");
        if (!link) return;
        const destination = new URL(link.href, window.location.href);
        if (destination.origin !== location.origin || destination.pathname !== location.pathname || !anchorTarget(destination.hash)) return;
        event.preventDefault();
        history.pushState(null, "", destination.hash);
        alignAnchor(destination.hash, true);
      });

      window.addEventListener("hashchange", () => requestAnimationFrame(() => alignAnchor(location.hash, false)));
      window.addEventListener("handbook:layout-ready", () => {
        if (location.hash) requestAnimationFrame(() => alignAnchor(location.hash, false));
      });
      window.addEventListener("load", () => {
        if (!location.hash) return;
        requestAnimationFrame(() => requestAnimationFrame(() => alignAnchor(location.hash, false)));
        document.fonts?.ready.then(() => alignAnchor(location.hash, false));
      });

      initializePage();
    </script>
  </body>
</html>

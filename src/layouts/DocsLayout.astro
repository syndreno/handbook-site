---
import { ArrowLeft, ArrowRight, ArrowUp, Copy, GitFork } from "@lucide/astro";
import type { CategoryMetadata, DocumentMetadata } from "@/types/documents";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Sidebar from "@/components/Sidebar.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import TableOfContents from "@/components/TableOfContents.astro";
import HandbookCard from "@/components/HandbookCard.astro";
import { withBase } from "@/utils/path";

interface Props {
  document: DocumentMetadata;
  categories: CategoryMetadata[];
  html: string;
  previous?: DocumentMetadata;
  next?: DocumentMetadata;
  related: DocumentMetadata[];
}
const { document, categories, html, previous, next, related } = Astro.props;
const sourceUrl = document.sourceUrl;
const breadcrumbs = [
  { name: "Home", path: "/" },
  ...document.sections.map((section) => ({
    name: section.name,
    path: `/categories/${section.path}/`
  })),
  { name: document.title, path: document.route }
];
---

<BaseLayout
  title={document.seoTitle}
  headline={document.title}
  description={document.description}
  type="article"
  keywords={[document.category, document.subcategory ?? "", ...document.tags].filter(Boolean)}
  articleSection={document.sections.map((section) => section.name).join(" / ")}
  wordCount={document.wordCount}
  {breadcrumbs}
>
  <div class="reading-progress" aria-hidden="true"><span data-reading-progress></span></div>
  <div class="docs-shell">
    <Sidebar categories={categories} currentRoute={document.route} />
    <main class="document-main" id="main-content">
      <Breadcrumbs document={document} />
      <article class="document" data-pagefind-body>
        <header class="document-header">
          <span class="eyebrow" data-pagefind-meta="category">{document.sections.map((section) => section.name).join(" / ")}</span>
          <h1 data-pagefind-meta="title">{document.title}</h1>
          <p>{document.description}</p>
          <div class="document-stats">
            <span>{document.readingMinutes} min read</span>
            <span>{document.wordCount.toLocaleString()} words</span>
            <span>{document.headingCount} sections</span>
          </div>
        </header>
        <div class="markdown-body" set:html={html}></div>
      </article>

      <div class="document-actions">
        <button type="button" data-copy-page><Copy size={17} />Copy link</button>
        {sourceUrl && <a href={sourceUrl} target="_blank" rel="noopener noreferrer"><GitFork size={17} />Edit on GitHub</a>}
      </div>

      {(previous || next) && <nav class="document-pagination" aria-label="Adjacent handbooks">
        {previous ? <a href={withBase(previous.route)}><span><ArrowLeft size={16} />Previous</span><strong>{previous.title}</strong></a> : <span></span>}
        {next ? <a class="next" href={withBase(next.route)}><span>Next<ArrowRight size={16} /></span><strong>{next.title}</strong></a> : <span></span>}
      </nav>}

      {related.length > 0 && <section class="related-section">
        <div class="section-heading"><div><span class="eyebrow">Keep learning</span><h2>Related handbooks</h2></div></div>
        <div class="handbook-grid compact">{related.map((item) => <HandbookCard document={item} />)}</div>
      </section>}
    </main>
    <TableOfContents headings={document.headings} />
  </div>
  <button class="back-to-top icon-button" type="button" data-back-to-top title="Back to top" aria-label="Back to top"><ArrowUp size={19} /></button>
</BaseLayout>

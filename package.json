{
  "name": "developer-master-handbook",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "sync:handbooks": "node scripts/sync-handbooks.mjs",
    "dev": "npm run sync:handbooks && astro dev",
    "dev:force": "npm run sync:handbooks && astro dev --force",
    "dev:status": "astro dev status",
    "dev:stop": "astro dev stop",
    "build": "npm run sync:handbooks && npm run lint:docs && astro build && pagefind --site dist",
    "preview": "astro preview",
    "check": "astro check",
    "lint:docs": "node scripts/validate-docs.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^7.2.1",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "@lucide/astro": "^1.31.0",
    "mdast-util-to-string": "^4.0.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-pretty-code": "^0.14.5",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "shiki": "^3.19.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "pagefind": "^1.5.2",
    "typescript": "^6.0.3"
  }
}
